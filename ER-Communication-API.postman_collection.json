            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "John Doe", "type": "text" },
                { "key": "email", "value": "john@example.com", "type": "text" },
                { "key": "phone", "value": "081234567890", "type": "text" },
                { "key": "address", "value": "Jakarta, Indonesia", "type": "text" },
                { "key": "cv", "type": "file", "src": [] }
