{
  "info": {
    "name": "ER Communication CMS API",
    "description": "Public & protected API for the ER Communication CMS (cms_arunika). Base path: {{base_url}}/api/v1. Protected endpoints (career-applications, contact-messages GET/show) require a Sanctum bearer token — generate one with:\n\nphp artisan tinker --execute=\"echo App\\Models\\User::first()->createToken('client-name')->plainTextToken;\"",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "ercom-cms-api-v1"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "api_token", "value": "" }
  ],
  "item": [
    {
      "name": "Landing",
      "item": [
        {
          "name": "Landing (all sections at once)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/landing", "host": ["{{base_url}}"], "path": ["api", "v1", "landing"] }
          }
        }
      ]
    },
    {
